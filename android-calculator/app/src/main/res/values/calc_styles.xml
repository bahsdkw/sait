<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="button_text_size">34sp</dimen>
    <dimen name="button_margin">6dp</dimen>

    <!-- Общий стиль всех кнопок: крупный жирный текст, равные размеры (вес 1) -->
    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/button_margin</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/calc_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- null отключает заливку Material-темы, чтобы работал наш android:background -->
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- Цифры и точка: полупрозрачный белый -->
    <style name="CalcButton.Digit">
        <item name="android:background">@drawable/btn_digit</item>
    </style>

    <!-- Операции и "=": оранжевый -->
    <style name="CalcButton.Operator">
        <item name="android:background">@drawable/btn_operator</item>
    </style>

    <!-- Очистка: белая кнопка с тёмным текстом -->
    <style name="CalcButton.Clear">
        <item name="android:background">@drawable/btn_clear</item>
        <item name="android:textColor">@color/calc_dark</item>
    </style>

    <!-- Одна строка кнопок -->
    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
