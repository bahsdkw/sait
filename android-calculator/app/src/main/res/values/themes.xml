<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Тема приложения: без строки заголовка, цвет фона и системных панелей - navy -->
    <style name="Theme.Calculator" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
    </style>

    <!-- Общий вид всех кнопок: крупный жирный текст, без тени и лишних отступов -->
    <style name="CalcButton" parent="android:Widget.Material.Button">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- Цифры и точка: светлая кнопка, тёмный текст -->
    <style name="CalcButton.Digit">
        <item name="android:background">@drawable/btn_digit</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <!-- Операции и «=»: оранжевая кнопка, тёмный текст -->
    <style name="CalcButton.Operator">
        <item name="android:background">@drawable/btn_operator</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <!-- C, удаление, смена знака: контурная кнопка, светлый текст -->
    <style name="CalcButton.Action">
        <item name="android:background">@drawable/btn_action</item>
        <item name="android:textColor">@color/light</item>
    </style>

</resources>
