<?xml version="1.0" encoding="utf-8"?>
<!-- Корневой контейнер: вертикально — сначала экран, потом кнопки -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ===== Экран калькулятора (занимает 2 части высоты из 7) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Выражение, которое вводит пользователь -->
        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="12.5 × 4"
            android:textColor="@color/calc_white"
            android:textSize="30sp" />

        <!-- Результат: крупный, текст сам уменьшается, если число длинное -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/calc_white"
            android:textSize="72sp"
            android:textStyle="bold"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeMinTextSize="32sp"
            android:autoSizeTextType="uniform" />
    </LinearLayout>

    <!-- ===== Блок кнопок (5 строк, 5 частей высоты из 7) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical">

        <!-- Строка 1: C (двойная ширина), стереть, деление -->
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btnClear"
                style="@style/CalcButton.Clear"
                android:layout_weight="2"
                android:text="C" />
            <Button
                android:id="@+id/btnBackspace"
                style="@style/CalcButton.Operator"
                android:text="⌫" />
            <Button
                android:id="@+id/btnDivide"
                style="@style/CalcButton.Operator"
                android:text="÷" />
        </LinearLayout>

        <!-- Строка 2: 7 8 9 × -->
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn7"
                style="@style/CalcButton.Digit"
                android:text="7" />
            <Button
                android:id="@+id/btn8"
                style="@style/CalcButton.Digit"
                android:text="8" />
            <Button
                android:id="@+id/btn9"
                style="@style/CalcButton.Digit"
                android:text="9" />
            <Button
                android:id="@+id/btnMultiply"
                style="@style/CalcButton.Operator"
                android:text="×" />
        </LinearLayout>

        <!-- Строка 3: 4 5 6 − -->
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn4"
                style="@style/CalcButton.Digit"
                android:text="4" />
            <Button
                android:id="@+id/btn5"
                style="@style/CalcButton.Digit"
                android:text="5" />
            <Button
                android:id="@+id/btn6"
                style="@style/CalcButton.Digit"
                android:text="6" />
            <Button
                android:id="@+id/btnMinus"
                style="@style/CalcButton.Operator"
                android:text="−" />
        </LinearLayout>

        <!-- Строка 4: 1 2 3 + -->
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn1"
                style="@style/CalcButton.Digit"
                android:text="1" />
            <Button
                android:id="@+id/btn2"
                style="@style/CalcButton.Digit"
                android:text="2" />
            <Button
                android:id="@+id/btn3"
                style="@style/CalcButton.Digit"
                android:text="3" />
            <Button
                android:id="@+id/btnPlus"
                style="@style/CalcButton.Operator"
                android:text="+" />
        </LinearLayout>

        <!-- Строка 5: 0 (двойная ширина), точка, равно -->
        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn0"
                style="@style/CalcButton.Digit"
                android:layout_weight="2"
                android:text="0" />
            <Button
                android:id="@+id/btnDot"
                style="@style/CalcButton.Digit"
                android:text="." />
            <Button
                android:id="@+id/btnEquals"
                style="@style/CalcButton.Operator"
                android:text="=" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
